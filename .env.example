VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_GIPHY_API_KEY=your_giphy_api_key

# IGDB / Twitch API (get from https://dev.twitch.tv/console)
VITE_TWITCH_CLIENT_ID=your_twitch_client_id
# TWITCH_CLIENT_SECRET is server-only; configure it in Supabase Edge Function secrets.

# Public feature flag only; defaults to false. Enable after verifying the server/provider setup.
VITE_MANGA_SEARCH_ENABLED=false
